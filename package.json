{
  "description": "Zero-config glob discovery exposing project files as modules or raw strings.",
  "devDependencies": {
    "@swc/core": "^1.3.101",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.15.5",
    "tslib": "^2.6.2",
    "tsup": "^8.0.1",
    "typescript": "^4.9.5",
    "vite": "^5.4.7"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.esm.js",
        "types": "./dist/index.d.mts"
      },
      "require": {
        "default": "./dist/index.cjs.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "keywords": [
    "vite",
    "plugin",
    "glob",
    "virtual-module",
    "raw",
    "vite-plugin",
    "glob-patterns",
    "file-discovery",
    "typescript-types"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "name": "@jswork/vite-plugin-file-hub",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "release": "release-it",
    "test": "bun test"
  },
  "types": "./dist/index.d.ts",
  "version": "0.0.1"
}
